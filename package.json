{
  "name": "solidity-workbench",
  "displayName": "Solidity Workbench",
  "description": "Productivity tools for Solidity and Foundry projects, starting with auto-import of symbols.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "solidity",
    "foundry",
    "forge",
    "auto import",
    "ethereum"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "node esbuild.mjs --tests && node out/integration/runTests.js",
    "vscode:prepublish": "npm run typecheck && npm run build:prod",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@solidity-parser/parser": "^0.20.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "picomatch": "^4.0.7",
    "smol-toml": "^1.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
